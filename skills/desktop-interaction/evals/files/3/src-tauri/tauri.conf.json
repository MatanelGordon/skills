{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Acme Notes",
  "version": "0.9.2",
  "identifier": "example.acme.notes",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Acme Notes", "width": 1100, "height": 720 },
      { "label": "settings", "title": "Settings", "width": 520, "height": 640, "visible": false }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
