new file mode 100644
index 0000000..20f1df1
--- /dev/null
+++ b/src/retry.py
@@ -0,0 +1,23 @@
+"""Call a function again when it fails, waiting longer each time."""
+
+
+class RetryError(Exception):
+    """Every attempt failed."""
+
+
+def call_with_retry(func, sleep, max_attempts=3, base_delay=0.5):
+    """Call func until it succeeds, at most max_attempts times.
+
+    Waits base_delay seconds after the first failure and doubles the wait
+    after each further one. Raises RetryError when every attempt has failed.
+    """
+    delay = base_delay
+    last_error = None
+    for _ in range(max_attempts + 1):
+        try:
+            return func()
+        except Exception as error:
+            last_error = error
+            sleep(delay)
+            delay *= 2
+    raise RetryError(f"gave up after {max_attempts} attempts") from last_error
diff --git a/tests/test_retry.py b/tests/test_retry.py
new file mode 100644
index 0000000..3818cdc
--- /dev/null
+++ b/tests/test_retry.py
@@ -0,0 +1,44 @@
+import unittest
+
+from src.retry import RetryError, call_with_retry
+
+
+class Flaky:
+    """Fails a set number of times, then returns "ok"."""
+
+    def __init__(self, failures):
+        self.failures = failures
+        self.calls = 0
+
+    def __call__(self):
+        self.calls += 1
+        if self.calls <= self.failures:
+            raise ConnectionError("down")
+        return "ok"
+
+
+class CallWithRetryTest(unittest.TestCase):
+    def setUp(self):
+        self.waits = []
+
+    def test_returns_the_first_success(self):
+        self.assertEqual(call_with_retry(Flaky(0), self.waits.append), "ok")
+        self.assertEqual(self.waits, [])
+
+    def test_retries_until_success(self):
+        self.assertEqual(call_with_retry(Flaky(2), self.waits.append), "ok")
+
+    def test_doubles_the_wait_between_attempts(self):
+        call_with_retry(Flaky(2), self.waits.append)
+        self.assertEqual(self.waits, [0.5, 1.0])
+
+    def test_gives_up_after_max_attempts(self):
+        func = Flaky(10)
+        with self.assertRaises(RetryError):
+            call_with_retry(func, self.waits.append, max_attempts=3)
+        self.assertEqual(func.calls, 3)
+
+    def test_retry_error_keeps_the_last_cause(self):
+        with self.assertRaises(RetryError) as caught:
+            call_with_retry(Flaky(10), self.waits.append)
+        self.assertIsInstance(caught.exception.__cause__, ConnectionError)
