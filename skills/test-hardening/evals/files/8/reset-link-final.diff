@@ -0,0 +1,12 @@
+"""Password reset links."""
+
+RESET_LINK_TTL_SECONDS = 1800
+
+
+def _age_seconds(issued_at, now):
+    return now - issued_at
+
+
+def is_reset_link_valid(issued_at, now):
+    """A reset link works for 30 minutes after it was issued, the last second included."""
+    return 0 <= _age_seconds(issued_at, now) <= RESET_LINK_TTL_SECONDS
