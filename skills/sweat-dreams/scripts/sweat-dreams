#!/usr/bin/env bash
# sweat-dreams — keep this Mac awake while a coding agent is working.
#
# One refcounted caffeinate for the whole machine. Each agent session takes a
# lease; the daemon holds the power assertion while at least one live lease
# exists and releases the moment the last one goes away, dies, or goes stale.
#
#   sweat-dreams on [--display] [--ttl SEC] [--force] [--label TEXT]
#   sweat-dreams beat               refresh this session's heartbeat (cheap, call while working)
#   sweat-dreams keep &             background keeper: beats until the agent exits, then releases
#   sweat-dreams off                release this session's lease
#   sweat-dreams status [--json]    what is holding the Mac awake, ours and foreign
#   sweat-dreams limit --detect     codex: read its reset time and stay awake until then + 1m
#   sweat-dreams limit --text "..."  claude/codex: parse a rate-limit message for the reset time
#   sweat-dreams kill               release everything sweat-dreams owns, now
#   sweat-dreams reap               drop dead/stale leases (the daemon does this too)
#   sweat-dreams menubar [install|uninstall|probe]
#
# Only claude / codex / copilot may take a lease; use --force to override.
# Machine stays awake, display is allowed to sleep unless --display is passed.
# On battery, the assertion is released below BATTERY_FLOOR (default 30%).
set -uo pipefail

HOME_DIR="${SWEAT_DREAMS_HOME:-$HOME/.sweat-dreams}"
LEASES="$HOME_DIR/leases"
LOCK="$HOME_DIR/.lock"
DAEMON_PID_FILE="$HOME_DIR/daemon.pid"
CAFF_PID_FILE="$HOME_DIR/caffeinate.pid"
LOG="$HOME_DIR/sweat-dreams.log"
CONFIG="$HOME_DIR/config"
HOLD_FILE="$HOME_DIR/hold_until"

BATTERY_FLOOR="${SWEAT_DREAMS_BATTERY_FLOOR:-30}"
STALE_AFTER="${SWEAT_DREAMS_STALE_AFTER:-300}"    # no heartbeat for this long = lease is stale
POLL="${SWEAT_DREAMS_POLL:-15}"                   # daemon loop interval, seconds
CAFF_TTL="${SWEAT_DREAMS_CAFF_TTL:-3600}"         # hard backstop on one caffeinate

[ -r "$CONFIG" ] && . "$CONFIG"

mkdir -p "$LEASES"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG" 2>/dev/null; }
die() { echo "sweat-dreams: $1" >&2; exit "${2:-1}"; }

# ------------------------------------------------------------------ locking
# mkdir is atomic on every filesystem we care about; flock is not on macOS.
lock() {
  local tries=0
  until mkdir "$LOCK" 2>/dev/null; do
    tries=$((tries + 1))
    if [ "$tries" -gt 100 ]; then
      # Stale lock from a killed process: break it if older than 30s.
      if [ -d "$LOCK" ] && [ -z "$(find "$LOCK" -maxdepth 0 -mmin -0.5 2>/dev/null)" ]; then
        rm -rf "$LOCK" 2>/dev/null; continue
      fi
      die "could not acquire lock at $LOCK"
    fi
    sleep 0.1
  done
}
unlock() { rm -rf "$LOCK" 2>/dev/null; }
trap 'unlock' EXIT INT TERM

alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }
now() { date +%s; }

# ------------------------------------------------- who is calling us
# Env vars first (fast, reliable), then a walk up the process tree.
detect_agent() {
  [ -n "${SWEAT_DREAMS_AGENT:-}" ] && { echo "$SWEAT_DREAMS_AGENT"; return 0; }
  [ -n "${CLAUDECODE:-}${CLAUDE_CODE_ENTRYPOINT:-}${CLAUDE_CODE_SESSION_ID:-}" ] && { echo claude; return 0; }
  [ -n "${CODEX_SANDBOX:-}${CODEX_HOME:-}${CODEX_SESSION_ID:-}" ] && { echo codex; return 0; }
  [ -n "${COPILOT_DEBUG_NONCE:-}${COPILOT_GITHUB_TOKEN:-}${COPILOT_ALLOW_ALL:-}" ] && { echo copilot; return 0; }

  local pid comm i=0
  pid=$PPID
  while [ "$i" -lt 12 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    comm="$(ps -o comm= -p "$pid" 2>/dev/null | sed 's#.*/##')"
    case "$comm" in
      claude*)  echo claude;  return 0 ;;
      codex*)   echo codex;   return 0 ;;
      copilot*) echo copilot; return 0 ;;
    esac
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    i=$((i + 1))
  done
  return 1
}

# Stable per-session id so repeated `on` calls refresh one lease, not many.
session_id() {
  local a="$1"
  case "$a" in
    claude)  echo "claude-${CLAUDE_CODE_SESSION_ID:-${CLAUDE_PID:-$PPID}}" ;;
    codex)   echo "codex-${CODEX_SESSION_ID:-$PPID}" ;;
    copilot) echo "copilot-${COPILOT_SESSION_ID:-$PPID}" ;;
    *)       echo "$a-$PPID" ;;
  esac
}

# The pid whose death should drop the lease: the agent process, not this shell.
holder_pid() {
  local pid comm i=0
  pid=$PPID
  while [ "$i" -lt 12 ] && [ -n "$pid" ] && [ "$pid" -gt 1 ] 2>/dev/null; do
    comm="$(ps -o comm= -p "$pid" 2>/dev/null | sed 's#.*/##')"
    case "$comm" in claude*|codex*|copilot*) echo "$pid"; return 0 ;; esac
    pid="$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ')"
    i=$((i + 1))
  done
  echo "$PPID"
}

# ------------------------------------------------------------------ battery
# echoes: "<source> <percent>"   source = AC | Battery | Unknown
power_state() {
  local out pct src
  out="$(pmset -g batt 2>/dev/null)"
  case "$out" in
    *"'AC Power'"*) src=AC ;;
    *"'Battery Power'"*) src=Battery ;;
    *) src=Unknown ;;
  esac
  pct="$(printf '%s' "$out" | grep -oE '[0-9]+%' | head -1 | tr -d '%')"
  echo "${src} ${pct:-100}"
}

battery_ok() {
  local st src pct
  st="$(power_state)"; src="${st%% *}"; pct="${st##* }"
  [ "$src" = "Battery" ] || return 0
  [ "$pct" -ge "$BATTERY_FLOOR" ] 2>/dev/null
}

notify() {
  [ "${SWEAT_DREAMS_NOTIFY:-1}" = "1" ] || return 0
  osascript -e "display notification \"$2\" with title \"sweat-dreams\" subtitle \"$1\"" >/dev/null 2>&1 &
}

# ------------------------------------------------------------------- leases
live_leases() {
  local f pid ts
  for f in "$LEASES"/*.lease; do
    [ -f "$f" ] || continue
    pid=$(sed -n 's/^pid=//p' "$f" 2>/dev/null | head -1)
    ts=$(sed -n 's/^heartbeat=//p' "$f" 2>/dev/null | head -1)
    if ! alive "$pid"; then rm -f "$f"; continue; fi
    if [ -n "$ts" ] && [ $(( $(now) - ts )) -gt "$STALE_AFTER" ]; then rm -f "$f"; continue; fi
    echo "$f"
  done
}
lease_count() { live_leases | grep -c . | tr -d ' '; }

# ------------------------------------------------------------------- daemon
caffeinate_args() {
  # -i idle system sleep, -m disk sleep, -s system sleep (AC only); -d display opt-in
  if [ -f "$HOME_DIR/.display" ]; then echo "-d -i -m -s"; else echo "-i -m -s"; fi
}

daemon_loop() {
  local caff_pid="" reason=""
  cleanup() {
    [ -n "$caff_pid" ] && kill "$caff_pid" 2>/dev/null
    rm -f "$CAFF_PID_FILE" "$DAEMON_PID_FILE"
    log "daemon stopped (${reason:-unknown})"
    exit 0
  }
  trap cleanup EXIT INT TERM

  while :; do
    if [ "$(lease_count)" -eq 0 ] && ! hold_active >/dev/null; then reason="no leases"; cleanup; fi

    if ! battery_ok; then
      if [ -n "$caff_pid" ] && alive "$caff_pid"; then
        kill "$caff_pid" 2>/dev/null; caff_pid=""; rm -f "$CAFF_PID_FILE"
        local st; st="$(power_state)"
        log "released: battery ${st##* }% below floor ${BATTERY_FLOOR}%"
        notify "Released" "Battery ${st##* }% is below the ${BATTERY_FLOOR}% floor — your Mac can sleep again."
      fi
      sleep "$POLL"; continue
    fi

    if [ -z "$caff_pid" ] || ! alive "$caff_pid"; then
      # shellcheck disable=SC2046
      caffeinate $(caffeinate_args) -t "$CAFF_TTL" &
      caff_pid=$!
      echo "$caff_pid" >"$CAFF_PID_FILE"
      log "caffeinate started pid=$caff_pid args='$(caffeinate_args) -t $CAFF_TTL'"
    fi
    sleep "$POLL"
  done
}

ensure_daemon() {
  local dpid
  dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
  alive "$dpid" && return 0
  rm -f "$DAEMON_PID_FILE" "$CAFF_PID_FILE"
  # Fully detach: the daemon must not inherit our stdout, or a caller doing
  # RESULT=$(sweat-dreams on) blocks until the daemon exits.
  ( daemon_loop </dev/null >>"$LOG" 2>&1 & echo $! >"$DAEMON_PID_FILE" ) </dev/null >/dev/null 2>&1 &
  sleep 0.4
  dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
  alive "$dpid" || return 1
  log "daemon started pid=$dpid"
}

stop_daemon() {
  local dpid cpid
  dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
  cpid=$(cat "$CAFF_PID_FILE" 2>/dev/null)
  alive "$dpid" && kill "$dpid" 2>/dev/null
  alive "$cpid" && kill "$cpid" 2>/dev/null
  rm -f "$DAEMON_PID_FILE" "$CAFF_PID_FILE"
}

# -------------------------------------------------------------- subcommands
cmd_on() {
  local force=0 ttl="" label="" display=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) force=1 ;;
      --display) display=1 ;;
      --ttl) shift; ttl="${1:-}" ;;
      --label) shift; label="${1:-}" ;;
      *) die "unknown option for on: $1" 64 ;;
    esac
    shift
  done

  local agent
  if ! agent="$(detect_agent)"; then
    [ "$force" = "1" ] || die "refusing: not called from claude, codex or copilot (use --force to override)" 3
    agent="manual"
  fi

  [ "$display" = "1" ] && : >"$HOME_DIR/.display"

  local id hpid f
  id="$(session_id "$agent")"; hpid="$(holder_pid)"
  lock
  f="$LEASES/$id.lease"
  {
    echo "id=$id"; echo "agent=$agent"; echo "pid=$hpid"
    echo "started=$(cat "$f" 2>/dev/null | sed -n 's/^started=//p' | head -1 || true)"
    echo "heartbeat=$(now)"; echo "cwd=$PWD"; echo "label=${label:-}"
    [ -n "$ttl" ] && echo "ttl=$ttl"
  } >"$f.tmp"
  # preserve original start time across refreshes
  grep -q '^started=$' "$f.tmp" && sed -i '' "s/^started=$/started=$(now)/" "$f.tmp"
  mv "$f.tmp" "$f"
  unlock

  ensure_daemon || die "could not start daemon (see $LOG)"
  if battery_ok; then
    echo "sweat-dreams: awake — $(lease_count) holder(s), this one: $agent"
  else
    local st; st="$(power_state)"
    echo "sweat-dreams: lease taken, but HOLDING OFF — battery ${st##* }% is below the ${BATTERY_FLOOR}% floor"
  fi
}

cmd_off() {
  local agent id
  agent="$(detect_agent)" || agent="manual"
  id="$(session_id "$agent")"
  lock; rm -f "$LEASES/$id.lease"; unlock
  local n; n=$(lease_count)
  if [ "$n" -eq 0 ]; then stop_daemon; echo "sweat-dreams: released — your Mac can sleep normally"
  else echo "sweat-dreams: lease dropped — $n other holder(s) still awake"; fi
}

cmd_kill() {
  lock; rm -f "$LEASES"/*.lease 2>/dev/null; unlock
  stop_daemon
  rm -f "$HOME_DIR/.display" "$HOLD_FILE"
  log "killed by user"
  echo "sweat-dreams: all leases dropped, assertion released"
  notify "Stopped" "All sweat-dreams leases released. Your Mac can sleep."
}

event() {   # small capped ring log, for "what happened while I was away"
  local ev="$HOME_DIR/events.log"
  printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$ev" 2>/dev/null
  # keep the last 200 lines only; no rotation files to clean up
  if [ "$(wc -l <"$ev" 2>/dev/null || echo 0)" -gt 300 ]; then
    tail -n 200 "$ev" >"$ev.tmp" 2>/dev/null && mv "$ev.tmp" "$ev"
  fi
}

cmd_beat() {   # cheap heartbeat refresh; no daemon churn, no output
  local agent id f
  agent="$(detect_agent)" || agent="manual"
  id="$(session_id "$agent")"
  f="$LEASES/$id.lease"
  [ -f "$f" ] || return 0                       # no lease -> nothing to refresh
  sed "s/^heartbeat=.*/heartbeat=$(now)/" "$f" >"$f.tmp" 2>/dev/null && mv "$f.tmp" "$f"
}

cmd_keep() {   # background keeper: beats while the agent lives, then exits
  local agent id hpid
  agent="$(detect_agent)" || die "keep: not called from an agent" 3
  id="$(session_id "$agent")"; hpid="$(holder_pid)"
  echo "$$" >"$HOME_DIR/keeper-$id.pid"
  event "keeper started id=$id agent=$agent holder=$hpid"
  while :; do
    # Orphan guard: if the agent that owns this lease is gone, stop immediately.
    alive "$hpid" || { event "keeper exit: holder $hpid gone"; break; }
    [ -f "$LEASES/$id.lease" ] || { event "keeper exit: lease released"; break; }
    cmd_beat
    sleep "${SWEAT_DREAMS_BEAT:-60}"
  done
  rm -f "$HOME_DIR/keeper-$id.pid"
  cmd_off >/dev/null 2>&1
}

hold_active() {   # echoes remaining seconds if a rate-limit hold is in force
  local until now_s
  [ -f "$HOLD_FILE" ] || return 1
  until=$(sed -n 's/^until=//p' "$HOLD_FILE" | head -1)
  case "$until" in ''|*[!0-9]*) return 1 ;; esac
  now_s=$(now)
  [ "$until" -gt "$now_s" ] || { rm -f "$HOLD_FILE"; return 1; }
  echo $(( until - now_s ))
}

cmd_limit() {
  local agent until="" text="" detect=0 pad="${SWEAT_DREAMS_LIMIT_PAD:-60}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --until) shift; until="${1:-}" ;;
      --text)  shift; text="${1:-}" ;;
      --detect) detect=1 ;;
      --pad)   shift; pad="${1:-60}" ;;
      --clear) rm -f "$HOLD_FILE"; echo "sweat-dreams: rate-limit hold cleared"; return 0 ;;
      *) die "unknown option for limit: $1" 64 ;;
    esac
    shift
  done

  agent="$(detect_agent)" || agent="manual"
  case "$agent" in
    copilot) die "limit holds are not used for copilot (by design)" 3 ;;
  esac

  local epoch=""
  if [ "$detect" = "1" ]; then
    epoch="$(python3 - <<'PYEOF'
import glob, json, os
best = None
for path in sorted(glob.glob(os.path.expanduser("~/.codex/sessions/**/rollout-*.jsonl"), recursive=True),
                   key=os.path.getmtime, reverse=True)[:20]:
    last = None
    for line in open(path, errors="ignore"):
        if '"rate_limits"' in line:
            last = line
    if not last:
        continue
    try:
        rl = (json.loads(last).get("payload") or {}).get("rate_limits") or {}
    except Exception:
        continue
    for w in ("primary", "secondary"):
        r = (rl.get(w) or {}).get("resets_at")
        if isinstance(r, int) and (best is None or r < best):
            best = r
    break
print(best or "")
PYEOF
)"
    [ -n "$epoch" ] || die "limit --detect: no codex rate-limit data found (use --until or --text)"
  elif [ -n "$text" ]; then
    epoch="$(SD_TEXT="$text" python3 - <<'PYEOF'
import os, re, time, calendar
t = os.environ.get("SD_TEXT", "").lower()
now = int(time.time())

# relative: "try again in 4h 30m", "retry after 120 seconds", "wait 5 minutes"
m = re.search(r'\b(?:in|after|wait|within)\b\s+(?:(\d+)\s*h(?:ours?|rs?)?)?\s*(?:(\d+)\s*m(?:in(?:utes?)?)?)?\s*(?:(\d+)\s*s(?:ec(?:onds?)?)?)?', t)
if m and any(g for g in m.groups()):
    h, mi, se = (int(g or 0) for g in m.groups())
    if h or mi or se:
        print(now + h*3600 + mi*60 + se); raise SystemExit

# absolute clock: "resets at 3pm", "resets 3:45 pm", "resets at 15:45"
m = re.search(r'reset[s]?\s*(?:at\s*)?(\d{1,2})(?::(\d{2}))?\s*(am|pm)?', t)
if m:
    hh = int(m.group(1)); mm = int(m.group(2) or 0); ap = m.group(3)
    if ap == "pm" and hh < 12: hh += 12
    if ap == "am" and hh == 12: hh = 0
    lt = time.localtime(now)
    cand = calendar.timegm(time.struct_time((lt.tm_year, lt.tm_mon, lt.tm_mday, hh, mm, 0, 0, 0, lt.tm_isdst))) - (calendar.timegm(time.localtime(now)) - now)
    if cand <= now: cand += 86400
    print(int(cand)); raise SystemExit

# ISO-ish or bare epoch
m = re.search(r'\b(1[7-9]\d{8})\b', t)
if m: print(int(m.group(1))); raise SystemExit
print("")
PYEOF
)"
    [ -n "$epoch" ] || die "limit --text: could not parse a reset time from that message"
  elif [ -n "$until" ]; then
    case "$until" in
      ''|*[!0-9]*) epoch="$(SD_TEXT="resets at $until" python3 -c "
import os,re,time,calendar
t=os.environ['SD_TEXT'].lower(); now=int(time.time())
m=re.search(r'(\d{1,2})(?::(\d{2}))?\s*(am|pm)?',t)
hh=int(m.group(1)); mm=int(m.group(2) or 0); ap=m.group(3)
if ap=='pm' and hh<12: hh+=12
if ap=='am' and hh==12: hh=0
lt=time.localtime(now)
off=calendar.timegm(time.localtime(now))-now
c=calendar.timegm(time.struct_time((lt.tm_year,lt.tm_mon,lt.tm_mday,hh,mm,0,0,0,lt.tm_isdst)))-off
if c<=now: c+=86400
print(int(c))")" ;;
      *) epoch="$until" ;;
    esac
  else
    die "limit: need --detect, --until <time|epoch>, or --text \"<message>\"" 64
  fi

  epoch=$(( epoch + pad ))
  local maxhold="${SWEAT_DREAMS_MAX_HOLD:-28800}"   # 8h default ceiling
  local span=$(( epoch - $(now) ))
  if [ "$span" -gt "$maxhold" ]; then
    echo "sweat-dreams: reset is $(( span / 3600 ))h away — that is longer than the ${maxhold}s ceiling." >&2
    echo "sweat-dreams: NOT holding. Raise SWEAT_DREAMS_MAX_HOLD to override, or let the Mac sleep." >&2
    event "rate-limit hold REFUSED: ${span}s exceeds ceiling ${maxhold}s"
    return 4
  fi
  { echo "until=$epoch"; echo "agent=$agent"; echo "set=$(now)"; } >"$HOLD_FILE"
  ensure_daemon >/dev/null 2>&1
  local mins=$(( (epoch - $(now)) / 60 ))
  event "rate-limit hold: agent=$agent until=$epoch (${mins}m, incl ${pad}s pad)"
  echo "sweat-dreams: holding awake for ${mins}m — until $(date -r "$epoch" '+%H:%M') (reset + ${pad}s)"
  notify "Rate limit" "Holding your Mac awake ${mins}m until $(date -r "$epoch" '+%H:%M')."
}

cmd_reap() { lock; live_leases >/dev/null; unlock; echo "sweat-dreams: reaped"; }

foreign_caffeinate() {
  local ours p
  ours=$(cat "$CAFF_PID_FILE" 2>/dev/null)
  for p in $(pgrep -x caffeinate 2>/dev/null); do
    [ "$p" = "$ours" ] && continue
    echo "$p $(ps -o args= -p "$p" 2>/dev/null)"
  done
}

cmd_status() {
  local json=0; [ "${1:-}" = "--json" ] && json=1
  local n cpid dpid st src pct held batt_block fg out line
  n=$(lease_count)
  cpid=$(cat "$CAFF_PID_FILE" 2>/dev/null)
  dpid=$(cat "$DAEMON_PID_FILE" 2>/dev/null)
  st="$(power_state)"; src="${st%% *}"; pct="${st##* }"
  if alive "$cpid"; then held=yes; else held=no; fi
  if battery_ok; then batt_block=no; else batt_block=yes; fi

  if [ "$json" = "1" ]; then
    printf '{"holding":%s,"leases":%s,"caffeinate_pid":%s,"daemon_pid":%s,"power":"%s","battery":%s,"floor":%s,"battery_blocked":%s,"display":%s}\n' \
      "$([ "$held" = yes ] && echo true || echo false)" "${n:-0}" "${cpid:-null}" "${dpid:-null}" \
      "$src" "${pct:-null}" "$BATTERY_FLOOR" \
      "$([ "$batt_block" = yes ] && echo true || echo false)" \
      "$([ -f "$HOME_DIR/.display" ] && echo true || echo false)"
    return 0
  fi

  # Build the whole report first, emit in one write, so `status | head` is quiet.
  out=""
  if [ "$held" = yes ]; then
    out="* AWAKE - sweat-dreams is preventing sleep (caffeinate pid $cpid)"
  elif [ "$n" -gt 0 ] && [ "$batt_block" = yes ]; then
    out="~ HOLDING OFF - $n lease(s), battery ${pct}% is below the ${BATTERY_FLOOR}% floor"
  elif [ "$n" -gt 0 ]; then
    out="~ STARTING - $n lease(s), assertion coming up"
  else
    out="o idle - sweat-dreams is not holding anything"
  fi

  local disp="allowed"; [ -f "$HOME_DIR/.display" ] && disp="prevented"
  out="$out
  power: $src ${pct}%   floor: ${BATTERY_FLOOR}%   display sleep: $disp"
  if [ -n "$dpid" ] && alive "$dpid"; then out="$out
  daemon: pid $dpid"; fi

  if [ "$n" -gt 0 ]; then
    out="$out
  holders:"
    local f agent hpid started label cwd age beat bage
    for f in "$LEASES"/*.lease; do
      [ -f "$f" ] || continue
      hpid=$(sed -n 's/^pid=//p' "$f" | head -1)
      alive "$hpid" || continue
      agent=$(sed -n 's/^agent=//p' "$f" | head -1)
      started=$(sed -n 's/^started=//p' "$f" | head -1)
      beat=$(sed -n 's/^heartbeat=//p' "$f" | head -1)
      label=$(sed -n 's/^label=//p' "$f" | head -1)
      cwd=$(sed -n 's/^cwd=//p' "$f" | head -1)
      case "$started" in ''|*[!0-9]*) started=$(now) ;; esac
      case "$beat" in ''|*[!0-9]*) beat=$(now) ;; esac
      age=$(( ($(now) - started) / 60 ))
      bage=$(( $(now) - beat ))
      line=$(printf '    %-9s pid %-7s up %dm  beat %ds ago  %s' "$agent" "$hpid" "$age" "$bage" "${label:-$cwd}")
      out="$out
$line"
    done
  fi

  local hold_left; hold_left="$(hold_active)" && out="$out
  rate-limit hold: $(( hold_left / 60 ))m left (until $(date -r "$(sed -n 's/^until=//p' "$HOLD_FILE"|head -1)" '+%H:%M'))"

  fg="$(foreign_caffeinate)"
  if [ -n "$fg" ]; then
    out="$out
  other caffeinate processes, not ours, left alone:
$(printf '%s' "$fg" | sed 's/^/    /')"
  fi

  out="$out

  stop it:  sweat-dreams kill"
  printf '%s\n' "$out"
}

cmd_menubar() { exec "$HOME_DIR/menubar.sh" "$@"; }

case "${1:-}" in
  on)      shift; cmd_on "$@" ;;
  off)     shift; cmd_off ;;
  status)  shift; cmd_status "$@" ;;
  kill)    shift; cmd_kill ;;
  beat)    shift; cmd_beat ;;
  keep)    shift; cmd_keep ;;
  limit)   shift; cmd_limit "$@" ;;
  reap)    shift; cmd_reap ;;
  menubar) shift; cmd_menubar "$@" ;;
  -h|--help|help|'') awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0" ;;
  *) die "unknown command: $1 (try --help)" 64 ;;
esac
