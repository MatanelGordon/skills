{
  "name": "@matanelgordon/skills",
  "version": "1.22.2",
  "description": "Agent Skills for Claude Code, OpenAI Codex, GitHub Copilot and Tabnine",
  "type": "module",
  "bin": {
    "install-skills": "tools/browser-capture/install-skills.mjs"
  },
  "scripts": {
    "install-skills": "node install/index.mjs",
    "start": "node install/index.mjs",
    "test:mutation-smoke": "node skills/mutation-testing/tests/run-calculator-smoke.mjs",
    "test:council": "node --test skills/council/tests/council-protocol.test.mjs",
    "test:impeccable-lite": "node --test skills/impeccable-lite/tests/*.test.mjs",
    "setup:browser-capture": "npm install --prefix tools/browser-capture --ignore-scripts --no-audit --no-fund",
    "test:browser-capture": "node tools/browser-capture/test.mjs",
    "validate": "node install/validate.mjs",
    "test": "node install/run-tests.mjs",
    "eval": "node install/run-evals.mjs"
  },
  "files": [
    "install/",
    "skills/",
    "agents/",
    "tools/browser-capture/README.md",
    "tools/browser-capture/cli.mjs",
    "tools/browser-capture/launcher.mjs",
    "tools/browser-capture/install-skills.mjs",
    "tools/browser-capture/test.mjs",
    "tools/browser-capture/package.json",
    "tools/browser-capture/npm-shrinkwrap.json",
    "tools/browser-capture/lib/",
    "tools/browser-capture/tests/"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Matanel Gordon",
  "repository": {
    "type": "git",
    "url": "https://github.com/MatanelGordon/skills.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "prompts": "^2.4.2"
  }
}
