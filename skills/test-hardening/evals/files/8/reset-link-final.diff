@@ -0,0 +1,11 @@
+import unittest
+
+from src.reset_link import is_reset_link_valid
+
+
+class ResetLinkTest(unittest.TestCase):
+    def test_link_works_one_minute_after_issue(self):
+        self.assertTrue(is_reset_link_valid(issued_at=1_000, now=1_060))
+
+    def test_link_is_dead_after_two_hours(self):
+        self.assertFalse(is_reset_link_valid(issued_at=1_000, now=8_200))
